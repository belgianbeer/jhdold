#!/bin/sh
# shar:    Shell Archiver
#	Run the following text with /bin/sh to create:
#	jhd.cat
#	jhd.1
# By:	Jim Omura ()
cat << \SHAR_EOF > jhd.cat

JHD(1)              UNIX Programmer's Manual               JHD(1)

名前
    jhd - 日本語に対応した 16進数、8進数、アスキー、漢字、かなダ
    ンプ

機能
    jhd [ -abcjkorvO ] [ <file> ] [ +[x|o]<offset>[k] ]

概要
    jhd は、UNIX の od(1) のフォーマットが見にくい（作者にとって）
    ために作成されたファイルダンププログラムです。しかも、もれな
    く漢字の表示ができるというオマケがついています（あれ？もれる
    のかな？そんなことはないはずだが.....  ）。

    オプションを指定せずに jhd を起動すると、1 行あたり、16 進数
    でファイルのオフセットが 8 桁、ファイルの内容が 2 桁 16 バイ
    ト、文字で 16 バイトの表示をしてくれます。またデータが同じ内
    容の繰り返しとなる場合は、表示をスキップします。ファイル名を
    省略した場合は、標準入力がキーボードの場合には、Usage メッセ
    ージが出力されます。

    オフセットは、“+数字”（10 進数）で指定します。ファイルの途
    中から見るのに利用します。数字の前に“x”をつけると 16 進数、
    “o”をつけると 8 進数となります。また数字の後に“k"をつける
    と、それぞれのオフセット値が 1024 倍されます。

    UNIX 版と OS9 版では、環境変数の“TTYPE”を参照して、以下の
    ように文字の表示を行ないます（NEWS の OS の仕様にあわせた）。

    mskanji
         漢字文字（もちろん ANK を含む）の表示を行ないます。

    jiskanji
         mskanjiと同様です。別に、JIS コードで表示を行なうとか、
         JIS コードを識別するといった芸はありませんので、あしか
         らず。

    kana 半角カタカナの表示を行ないます。ただし内部コードがEUCの
         ときは、このモードは存在しません。

    ascii
         ASCII キャラクタの表示を行ないます。TTYPE が設定されて
         いないときも、このモードとなります。

    MS-DOS 版（LSI-C)では、デフォルトで漢字を表示するようになっ
    ています。

    以下のオプションがあります。

    -a   ASCIIキャラクタのみの表示を行ないます（環境変数より優先
         される）。

    -b   データの内容をバイト単位の 8 進数で表示します。

    -c   文字のみを一行 64 バイトで表示します。

    -j   文字の表示部を、漢字コードに合致するなら、強制的に漢字
         で表示します（環境変数より優先される）。

    -k   文字の表示部を、漢字の表示を禁止して半角カタカナまでと
         します（内部コードが Shift-JIS のとき。環境変数より優先
         される）。

    -o   データの内容をワード単位の 8 進数で表示します。バイトオ
         ーダーは、システムに依存せず 68000 のようになります。

    -r   データの内容をワード単位の 8 進数で表示します。バイトオ
         ーダーは、システムに依存せず 8086 のようになります。

    -v   同じデータの繰り返しのスキップを禁止します。

参照
    od(1)

作者
    民田雅人 （masat-m@ascii.junet）

バグ
    バグらしき動作が確認された場合は、私（masat-m@ascii.junet）
    まで連絡いただければ、それがバグであると確認された場合は、善
    処したいと思います。
SHAR_EOF
cat << \SHAR_EOF > jhd.1
